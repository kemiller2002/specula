<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Fixtures.fs" />
    <Compile Include="RepoTests.fs" />
    <Compile Include="GitHubTests.fs" />
    <Compile Include="StatusTests.fs" />
    <Compile Include="EventsTests.fs" />
    <Compile Include="EvidenceTests.fs" />
    <Compile Include="MetricsTests.fs" />
    <Compile Include="PreferencesTests.fs" />
    <Compile Include="TimeTests.fs" />
    <Compile Include="UpdateTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Specula.Engine/Specula.Engine.fsproj" />
  </ItemGroup>
</Project>
