<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <Nullable>disable</Nullable>
    <!-- Build provenance is supplied by scripts/build.sh (CI sets the real SHA). -->
    <SpeculaSourceSha Condition="'$(SpeculaSourceSha)' == ''">unversioned-local-build</SpeculaSourceSha>
    <SpeculaBuildTime Condition="'$(SpeculaBuildTime)' == ''">unknown</SpeculaBuildTime>
    <SpeculaVersion Condition="'$(SpeculaVersion)' == ''">1.0.0</SpeculaVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BaseIntermediateOutputPath)BuildInfo.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="Domain.fs" />
    <Compile Include="Repo.fs" />
    <Compile Include="Time.fs" />
    <Compile Include="GitHub.fs" />
    <Compile Include="Status.fs" />
    <Compile Include="Events.fs" />
    <Compile Include="Evidence.fs" />
    <Compile Include="Preferences.fs" />
    <Compile Include="Metrics.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Update.fs" />
    <Compile Include="View.fs" />
    <Compile Include="Dispatch.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EchelonFoundry.Limen.Contract" Version="0.9.1" />
    <PackageReference Include="EchelonFoundry.Limen.Guest" Version="0.9.1" />
  </ItemGroup>
  <Target Name="SpeculaBuildInfo" BeforeTargets="BeforeBuild;CoreCompile">
    <PropertyGroup>
      <_BuildInfoText>// Generated at build time. Do not edit.
namespace Specula.Engine

module BuildInfo =
    [&lt;Literal&gt;]
    let SourceSha = "$(SpeculaSourceSha)"
    [&lt;Literal&gt;]
    let BuildTime = "$(SpeculaBuildTime)"
    [&lt;Literal&gt;]
    let Version = "$(SpeculaVersion)"
</_BuildInfoText>
    </PropertyGroup>
    <WriteLinesToFile File="$(BaseIntermediateOutputPath)BuildInfo.fs" Lines="$(_BuildInfoText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
