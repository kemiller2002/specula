<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Limen's F# packages are published as Sigstore-attested GitHub release
       assets (kemiller2002/limen v0.9.1), not on nuget.org. They are vendored
       here and verified against the release's checksums.txt in CI. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="limen-release-assets" value="vendor/nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="limen-release-assets">
      <package pattern="EchelonFoundry.Limen.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
